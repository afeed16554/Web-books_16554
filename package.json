{
  "name": "web-books",
  "version": "1.0.3",
  "description": "Clean, distraction-free Android Dex digital concept reader and notebook by Afeed",
  "author": "Afeed",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build --base=./",
    "preview": "vite preview",
    "test": "node --test src/utils/chemistrySections.test.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:dist": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.afeed.webbooks",
    "productName": "Web Books",
    "publish": null,
    "directories": {
      "output": "release-builds"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.3",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
