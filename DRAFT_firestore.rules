rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 & Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Selective Admin check: Bootstrapped primary admin email (with email_verified guard) or document in /admins/{uid}
    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'fha16554@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprint: UserPrivateProfile
    function isValidUserPrivateProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'phoneNumber', 'studentClass', 'schoolName', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'phoneNumber', 'studentClass', 'schoolName', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.phoneNumber is string && data.phoneNumber.size() >= 0 && data.phoneNumber.size() <= 30
        && data.studentClass is string && data.studentClass.size() >= 0 && data.studentClass.size() <= 60
        && data.schoolName is string && data.schoolName.size() >= 0 && data.schoolName.size() <= 160
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: FeedbackItem
    function isValidFeedbackItem(data) {
      return data.keys().hasAll(['authorUid', 'authorName', 'phoneNumber', 'topicId', 'rating', 'message', 'createdAt'])
        && data.keys().hasOnly(['authorUid', 'authorName', 'phoneNumber', 'topicId', 'rating', 'message', 'createdAt'])
        && data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 && data.authorUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.authorUid == request.auth.uid
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && data.phoneNumber is string && data.phoneNumber.size() >= 0 && data.phoneNumber.size() <= 30
        && data.topicId is string && data.topicId.size() >= 1 && data.topicId.size() <= 128 && data.topicId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 2000
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: CustomTopicPage
    function isValidCustomTopicPage(data) {
      return data.keys().hasAll(['authorUid', 'className', 'subject', 'paper', 'chapter', 'title', 'sectionsHtml', 'createdAt'])
        && data.keys().hasOnly(['authorUid', 'className', 'subject', 'paper', 'chapter', 'title', 'sectionsHtml', 'createdAt'])
        && data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 && data.authorUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.authorUid == request.auth.uid
        && data.className is string && data.className.size() >= 1 && data.className.size() <= 80
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80
        && data.paper is string && data.paper.size() >= 1 && data.paper.size() <= 80
        && data.chapter is string && data.chapter.size() >= 1 && data.chapter.size() <= 160
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.sectionsHtml is string && data.sectionsHtml.size() >= 1 && data.sectionsHtml.size() <= 200000
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: AdminRecord
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'addedByUid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'addedByUid', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.addedByUid is string && data.addedByUid.size() >= 1 && data.addedByUid.size() <= 128 && data.addedByUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.addedByUid == request.auth.uid
        && data.createdAt is timestamp;
    }

    // Collection 1: Isolated Private User Profiles (Phone, Student Class, School)
    match /users_private/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserPrivateProfile(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidUserPrivateProfile(incoming())
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'phoneNumber', 'studentClass', 'schoolName', 'updatedAt']);
      allow delete: if false;
    }

    // Collection 2: User Feedbacks
    match /feedbacks/{feedbackId} {
      allow get: if isSignedIn() && isValidId(feedbackId) && (existing().authorUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().authorUid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(feedbackId)
        && isValidFeedbackItem(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(feedbackId) && (existing().authorUid == request.auth.uid || isAdmin());
    }

    // Collection 3: Custom Uploaded Topic Pages (Admin-managed)
    match /custom_topics/{topicPageId} {
      allow get: if isSignedIn() && isValidId(topicPageId) && (existing().authorUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().authorUid == request.auth.uid;
      allow create: if isAdmin()
        && isValidId(topicPageId)
        && isValidCustomTopicPage(incoming())
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidCustomTopicPage(incoming())
        && isValidId(topicPageId)
        && existing().authorUid == request.auth.uid
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['className', 'subject', 'paper', 'chapter', 'title', 'sectionsHtml']);
      allow delete: if isAdmin() && isValidId(topicPageId) && existing().authorUid == request.auth.uid;
    }

    // Collection 4: Selective Admin Registry
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(adminUid)
        && incoming().uid == adminUid
        && isValidAdminRecord(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminUid);
    }
  }
}
